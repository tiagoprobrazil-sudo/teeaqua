---
import Base from '../layouts/Base.astro';import Heading from '../components/ui/PageHeading.astro';import Impact from '../sections/Impact.astro';import Icon from '../components/ui/Icon.astro';
const solutions=[{icon:'Sun',title:'Para sua casa',text:'Produtos e acessórios para simplificar o cuidado com a piscina e deixar mais tempo para aproveitar.',subject:'Soluções para minha casa'},{icon:'Wrench',title:'Para profissionais',text:'Materiais e equipamentos para quem trabalha com a instalação, limpeza e manutenção de piscinas.',subject:'Soluções para profissionais'},{icon:'Truck',title:'Para empresas',text:'Uma conversa dedicada às necessidades de abastecimento e distribuição do seu negócio.',subject:'Soluções para empresas'}] as const;
---
<Base title="Soluções"><Heading eyebrow="CADA PISCINA, UM CUIDADO" title="A solução certa para o seu momento." description="Da rotina de casa às necessidades de quem trabalha com piscinas."/><section class="section"><div class="container solutions-grid">{solutions.map(s=><article class="solution"><Icon name={s.icon} size={36}/><h2>{s.title}</h2><p>{s.text}</p><a class="text-link" href={'/contato?mensagem='+encodeURIComponent(s.subject)}>Vamos conversar <Icon name="ArrowUpRight" size={18}/></a></article>)}</div></section><Impact/></Base>

