---
import Base from '../layouts/Base.astro'; import Hero from '../components/home/Hero'; import Benefits from '../sections/Benefits.astro'; import Company from '../sections/Company.astro'; import Impact from '../sections/Impact.astro';
import Icon from '../components/ui/Icon.astro'; import ProductCard from '../components/catalog/ProductCard.astro'; import PostCard from '../components/PostCard.astro';
import {getCategories,getProducts,getBrands,getPosts} from '../services/catalog';
import type {Category,Product,Brand,Post} from '../types/catalog';
let categories:Category[]=[],products:Product[]=[],brands:Brand[]=[],posts:Post[]=[]; let unavailable=false;
try { [categories,{products},brands,posts]=await Promise.all([getCategories(),getProducts(new URLSearchParams(),true),getBrands(),getPosts()]); } catch { unavailable=true; }
---
<Base hero><Hero client:load/><Benefits/><Company/>
<section class="section categories-section" id="categorias"><div class="container"><div class="section-heading"><div><p class="eyebrow">DO ESSENCIAL AO EXTRAORDINÁRIO</p><h2>Tudo o que sua<br/>piscina <span>precisa.</span></h2></div><div><p>Encontre a solução certa para cada cuidado. <br/>Explore nossas categorias.</p><a class="text-link" href="/produtos">Ver todos os produtos <Icon name="ArrowUpRight" size={20}/></a></div></div><div class="category-grid">{categories.slice(0,4).map((c,i)=><a class="category-card" href={'/produtos?categoria='+c.slug}><img src={c.imagem} alt="" width="650" height="800" loading="lazy"/><span class="category-index">0{i+1}</span><div><h3>{c.nome}</h3><p>{c.descricao}</p></div><span class="category-arrow"><Icon name="ArrowUpRight"/></span></a>)}</div><div class="category-links">{categories.slice(4).map(c=><a href={'/produtos?categoria='+c.slug}>{c.nome}<Icon name="ArrowUpRight" size={17}/></a>)}</div>{unavailable&&<p role="status">O catálogo está temporariamente indisponível. <a href="/contato">Fale com nossa equipe.</a></p>}</div></section>
<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">ESCOLHAS PARA CUIDAR MELHOR</p><h2>Produtos em <span>destaque.</span></h2></div><a class="text-link" href="/produtos">Explore o catálogo <Icon name="ArrowUpRight" size={20}/></a></div><div class="product-grid home-products">{products.map(product=><ProductCard product={product}/>)}</div>{!products.length&&!unavailable&&<p>Nosso catálogo está em preparação. Fale com a equipe para conhecer as soluções disponíveis.</p>}</div></section>
<section class="brands-section"><div class="container brands-row"><div><p class="eyebrow">QUALIDADE EM CADA ESCOLHA</p><h2>Marcas e soluções</h2></div><div class="brand-list">{brands.length?brands.map(b=>b.logo?<img src={b.logo} alt={b.nome} width="140" height="60" loading="lazy"/>:<span>{b.nome}</span>):<><span class="brand-placeholder">TRATAMENTO</span><span class="brand-placeholder">EQUIPAMENTOS</span><span class="brand-placeholder">ACESSÓRIOS</span></>}</div></div><!-- Neutral placeholders represent solution groups, never manufacturer partnerships. --></section>
<Impact/>{posts.length>0&&<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">INSPIRAÇÃO E CUIDADO</p><h2>Uma piscina melhor.<br/>Todos os <span>dias.</span></h2></div><a class="text-link" href="/dicas">Mais dicas para você <Icon name="ArrowUpRight" size={20}/></a></div><div class="posts-grid">{posts.slice(0,3).map(post=><PostCard post={post}/>)}</div></div></section>}
<section class="contact-strip"><video class="contact-strip-video" data-lazy autoplay muted loop playsinline preload="none" poster="/video/pool-sunlight-poster.jpg" aria-hidden="true"><source data-src="/video/pool-sunlight.mp4" type="video/mp4"/></video><div class="contact-strip-overlay"></div><div class="container"><div><p class="eyebrow">VAMOS CUIDAR DA SUA PISCINA?</p><h2>A solução começa com uma conversa.</h2></div><a class="button button-dark" href="/contato?assunto=Orçamento">Solicitar orçamento <Icon name="ArrowUpRight" size={20}/></a></div></section>
</Base>

