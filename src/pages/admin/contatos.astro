---
import Admin from '../../layouts/Admin.astro';import Actions from '../../components/admin/AdminActions.astro';
const page=Math.max(1,Number(Astro.url.searchParams.get('pagina'))||1);const {data:contacts,error,count}=await Astro.locals.supabase!.from('contacts').select('*',{count:'exact'}).order('created_at',{ascending:false}).range((page-1)*20,page*20-1);
---
<Admin title="Contatos recebidos"><div class="admin-card">{error?<p class="form-feedback error">Não foi possível carregar as mensagens.</p>:contacts?.length?contacts.map(c=><article class="contact-message"><div class="post-meta"><span>{c.assunto}</span><time datetime={c.created_at}>{new Date(c.created_at).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'})}</time></div><h2>{c.nome}</h2><dl><div><dt>E-mail</dt><dd><a href={'mailto:'+c.email}>{c.email}</a></dd></div><div><dt>Empresa / Cidade</dt><dd>{c.empresa||'—'} / {c.cidade}</dd></div><div><dt>Telefone</dt><dd>{c.telefone||'—'}</dd></div><div><dt>WhatsApp</dt><dd>{c.whatsapp||'—'}</dd></div></dl><p>{c.mensagem}</p><form data-admin-form action="/api/admin/contacts" method="post" class="admin-form"><input type="hidden" name="id" value={c.id}/><label>Status<select name="status"><option value="novo" selected={c.status==='novo'}>Novo</option><option value="em_atendimento" selected={c.status==='em_atendimento'}>Em atendimento</option><option value="concluido" selected={c.status==='concluido'}>Concluído</option></select></label><button type="submit" class="button button-dark">Atualizar status</button></form></article>):<p>Nenhuma mensagem recebida.</p>}</div><nav class="pagination" aria-label="Paginação">{page>1&&<a href={'?pagina='+(page-1)}>Anterior</a>}{(count||0)>page*20&&<a href={'?pagina='+(page+1)}>Próxima</a>}</nav><Actions/></Admin>

