---
import Base from '../../layouts/Base.astro';import {env} from 'cloudflare:workers';import {configured} from '../../lib/supabase';import {sameOrigin} from '../../lib/validation';
if(Astro.locals.user)return Astro.redirect('/admin');
const ready=configured()&&Boolean(env.TURNSTILE_SITE_KEY&&env.TURNSTILE_SECRET_KEY&&env.TURNSTILE_HOSTNAMES);
let error='';
if(Astro.request.method==='POST'){
if(!sameOrigin(Astro.request)){error='Solicitação inválida.';Astro.response.status=403;}
else if(!ready){error='A autenticação ainda não foi configurada.';Astro.response.status=503;}
else{
try{
const form=await Astro.request.formData();const email=String(form.get('email')||'').slice(0,254),password=String(form.get('password')||'');const token=String(form.get('cf-turnstile-response')||'');
if(password.length>200||!token||token.length>2048)throw new Error('Verifique os campos e tente novamente.');
const validation=await fetch('https://challenges.cloudflare.com/turnstile/v0/siteverify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({secret:env.TURNSTILE_SECRET_KEY,response:token,remoteip:Astro.request.headers.get('CF-Connecting-IP')||undefined}),signal:AbortSignal.timeout(8000)});
const result=await validation.json() as {success:boolean;hostname:string;action:string};
if(!result.success||result.action!=='login'||!env.TURNSTILE_HOSTNAMES!.split(',').map(s=>s.trim()).includes(result.hostname))throw new Error('Conclua novamente a verificação de segurança.');
const {data,error:authError}=await Astro.locals.supabase!.auth.signInWithPassword({email,password});
if(authError||data.user?.app_metadata?.role!=='admin'){await Astro.locals.supabase!.auth.signOut();error='Credenciais inválidas ou acesso não autorizado.';Astro.response.status=401;}
else return Astro.redirect('/admin',303);
}catch{error='Não foi possível entrar. Confira os dados e a verificação de segurança.';Astro.response.status=400;}
}}
---
<Base title="Acesso administrativo" noindex><section class="login-section"><p class="eyebrow">ÁREA RESTRITA</p><h1>Bem-vindo de volta.</h1><p>Acesse a administração da T&E Aqua.</p>{!ready&&<p class="notice">O acesso administrativo estará disponível após a configuração segura do serviço.</p>}{error&&<p role="alert" class="form-feedback error">{error}</p>}<form method="post" class="contact-form"><label>E-mail<input name="email" type="email" autocomplete="username" required maxlength="254"/></label><label>Senha<input name="password" type="password" autocomplete="current-password" required maxlength="200"/></label>{ready&&<div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-action="login"/>}<button class="button button-dark" disabled={!ready}>Entrar</button></form></section>{ready&&<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer/>}</Base>

