---
import Admin from '../../layouts/Admin.astro';import Actions from '../../components/admin/AdminActions.astro';import {adminResources,type Resource} from '../../config/admin';
const key=Astro.params.resource as Resource;if(!Object.hasOwn(adminResources,key))return Astro.redirect('/404');
const config=adminResources[key];const id=Astro.url.searchParams.get('editar');const db=Astro.locals.supabase!;
const page=Math.max(1,Number(Astro.url.searchParams.get('pagina'))||1);
const {data:rows,error,count}=await db.from(config.table).select('*',{count:'exact'}).order('created_at',{ascending:false}).range((page-1)*30,page*30-1);
const {data:record,error:recordError}=id?await db.from(config.table).select('*').eq('id',id).maybeSingle():{data:null,error:null};
const {data:postCategories}=key==='artigos'?await db.from('post_categories').select('*').order('nome'):{data:null};
const isEditing=Boolean(record);const api='/api/admin/resources/'+key;
---
<Admin title={config.title}>{error||recordError?<p class="form-feedback error">Não foi possível carregar os dados.</p>:<><div class="admin-card"><h2 style="font-size:23px">{isEditing?'Editar registro':'Novo registro'}</h2><form class="admin-form" data-admin-form data-return={'/admin/'+key} action={api} method="post"><input type="hidden" name="id" value={record?.id||''}/>{config.fields.map(([name,label])=><label class:list={[{ 'full-width':['conteudo','descricao','resumo'].includes(name)}]}>{label}{['conteudo','descricao','resumo'].includes(name)?<textarea name={name} maxlength={name==='conteudo'?50000:2000} rows={name==='conteudo'?10:3}>{record?.[name]||''}</textarea>:<input name={name} type={name==='ordem'?'number':name==='published_at'?'datetime-local':'text'} required={['nome','titulo','slug'].includes(name)} min={name==='ordem'?'0':undefined} maxlength="500" value={name==='published_at'?(record?.[name]?.slice(0,16)||''):record?.[name]??(name==='ordem'?0:'')}/>}</label>)}{key==='artigos'&&<label>Categoria do artigo<select name="categoria_id"><option value="">Sem categoria</option>{postCategories?.map(c=><option value={c.id} selected={record?.categoria_id===c.id}>{c.nome}</option>)}</select></label>}<label class="checkbox full-width"><input type="checkbox" name={config.active} checked={record?.[config.active]??false}/>{key==='artigos'?'Publicar artigo (data obrigatória)':'Registro ativo'}</label>{key==='artigos'&&<p class="form-note full-width">A data é armazenada em UTC. Conteúdo é texto simples, sem execução de HTML.</p>}<button type="submit" class="button button-dark">Salvar</button>{isEditing&&<a class="text-link" href={'/admin/'+key}>Cancelar edição</a>}</form></div><div class="admin-card table-scroll"><table class="admin-table"><thead><tr><th>Nome</th><th>Slug</th><th>Status</th><th>Ações</th></tr></thead><tbody>{rows?.map(row=><tr><td>{row.nome||row.titulo}</td><td>{row.slug}</td><td>{row[config.active]?'Ativo':'Inativo'}</td><td><div class="row-actions"><a href={'?editar='+row.id}>Editar</a><button data-delete={api+'?id='+row.id} data-label={row.nome||row.titulo}>Excluir</button></div></td></tr>)}</tbody></table>{!rows?.length&&<p>Nenhum registro cadastrado.</p>}</div><nav class="pagination" aria-label="Paginação">{page>1&&<a href={'?pagina='+(page-1)}>Anterior</a>}{(count||0)>page*30&&<a href={'?pagina='+(page+1)}>Próxima</a>}</nav></>}<Actions/></Admin>

