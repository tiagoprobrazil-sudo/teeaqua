---
import Admin from '../../../layouts/Admin.astro';import AdminActions from '../../../components/admin/AdminActions.astro';
const page=Math.max(1,Number(Astro.url.searchParams.get('pagina'))||1);const {data:products,error,count}=await Astro.locals.supabase!.from('products').select('id,nome,codigo,ativo,destaque,categories(nome)',{count:'exact'}).order('ordem').order('id').range((page-1)*30,page*30-1);
---
<Admin title="Produtos"><a slot="action" class="button button-dark" href="/admin/produtos/novo">Novo produto +</a><div class="admin-card">{error?<p class="form-feedback error">Não foi possível carregar os produtos.</p>:<div class="table-scroll"><table class="admin-table"><thead><tr><th>Produto</th><th>Código</th><th>Status</th><th>Destaque</th><th>Ações</th></tr></thead><tbody>{products?.map(p=><tr><td>{p.nome}</td><td>{p.codigo}</td><td><span class:list={['status-pill',{inactive:!p.ativo}]}>{p.ativo?'Ativo':'Inativo'}</span></td><td>{p.destaque?'Sim':'Não'}</td><td><div class="row-actions"><a href={'/admin/produtos/'+p.id}>Editar</a><button data-delete={'/api/admin/products/'+p.id} data-label={p.nome}>Excluir</button></div></td></tr>)}</tbody></table>{!products?.length&&<p>Nenhum produto cadastrado.</p>}</div>}</div><nav class="pagination" aria-label="Paginação administrativa">{page>1&&<a href={'?pagina='+(page-1)}>Anterior</a>}{(count||0)>page*30&&<a href={'?pagina='+(page+1)}>Próxima</a>}</nav><AdminActions/></Admin>

