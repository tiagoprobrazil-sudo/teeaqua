---
import Base from '../layouts/Base.astro';import Heading from '../components/ui/PageHeading.astro';import Icon from '../components/ui/Icon.astro';import {site,whatsappUrl} from '../config/site';import {env} from 'cloudflare:workers';
const ready=Boolean(env.SUPABASE_URL&&env.SUPABASE_SERVICE_ROLE_KEY&&env.TURNSTILE_SITE_KEY&&env.TURNSTILE_SECRET_KEY&&env.TURNSTILE_HOSTNAMES);
const subjects=['Orçamento','Produtos','Distribuição','Suporte','Outros'];const selected=Astro.url.searchParams.get('assunto')||'Orçamento';const product=Astro.url.searchParams.get('produto');const message=product?'Olá! Gostaria de um orçamento para '+product+'.':Astro.url.searchParams.get('mensagem')||'';
---
<Base title="Contato"><Heading eyebrow="VAMOS CONVERSAR" title="O próximo mergulho começa aqui." description="Conte o que você precisa. Nossa equipe ajuda a encontrar as soluções para sua piscina."/><section class="section"><div class="container contact-layout"><aside class="contact-aside"><p class="eyebrow">ATENDIMENTO T&E AQUA</p><h2>Como podemos<br/>ajudar você?</h2><p>Envie sua dúvida, solicite um orçamento ou converse sobre as necessidades do seu negócio.</p><div class="contact-channels">{site.whatsapp&&<a href={whatsappUrl()}><Icon name="MessageCircle"/> Conversar pelo WhatsApp <Icon name="ArrowUpRight" size={17}/></a>}{site.phone&&<a href={'tel:'+site.phone.replace(/[^+\d]/g,'')}><Icon name="Phone"/>{site.phone}</a>}{site.email&&<a href={'mailto:'+site.email}><Icon name="Mail"/>{site.email}</a>}{site.address&&<div><Icon name="MapPin"/>{site.address}</div>}</div></aside><div>{!ready&&<p class="notice">Nosso atendimento online está em preparação. O envio estará disponível em breve.</p>}<form id="contact-form" class="contact-form" action="/api/contact" method="post"><label>Nome *<input name="nome" autocomplete="name" required minlength="2" maxlength="120" placeholder="Seu nome"/></label><label>Empresa<input name="empresa" autocomplete="organization" maxlength="160" placeholder="Nome da empresa"/></label><label>Telefone<input name="telefone" type="tel" autocomplete="tel" maxlength="30" placeholder="DDD + telefone"/></label><label>WhatsApp<input name="whatsapp" type="tel" maxlength="30" placeholder="DDD + WhatsApp"/></label><label>E-mail *<input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="seu@email.com"/></label><label>Cidade *<input name="cidade" autocomplete="address-level2" required minlength="2" maxlength="120" placeholder="Sua cidade / UF"/></label><label class="full-width">Assunto *<select name="assunto" required>{subjects.map(subject=><option selected={subject===selected}>{subject}</option>)}</select></label><label class="full-width">Mensagem *<textarea name="mensagem" required minlength="10" maxlength="5000" rows="5" placeholder="Conte um pouco sobre o que você precisa.">{message}</textarea></label><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"/></label><input type="hidden" name="started_at" value={Date.now()}/><label class="checkbox full-width"><input name="consentimento" type="checkbox" required/><span>Autorizo o uso dos meus dados para responder a esta solicitação, conforme a <a href="/privacidade">Política de Privacidade</a>.</span></label>{ready&&<div class="full-width cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-action="contact" data-theme="light"/>}<p class="form-feedback full-width" id="contact-feedback" role="status" tabindex="-1" hidden></p><div class="full-width"><button class="button button-dark" type="submit" disabled={!ready}>Enviar mensagem <Icon name="ArrowUpRight" size={18}/></button></div><p class="form-note full-width">* Campos obrigatórios. Seus dados serão usados para este atendimento.</p></form></div></div></section>{ready&&<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer/>}</Base>
<script>
const form=document.querySelector<HTMLFormElement>('#contact-form')!;
form.addEventListener('submit',async e=>{e.preventDefault();const button=form.querySelector<HTMLButtonElement>('button[type=submit]')!;const feedback=document.getElementById('contact-feedback')!;button.disabled=true;feedback.hidden=true;
try{const response=await fetch(form.action,{method:'POST',body:new FormData(form)});const result=await response.json();feedback.textContent=response.ok?'Mensagem recebida. Obrigado! Nossa equipe entrará em contato pelos dados informados.':result.error||'Não foi possível enviar. Tente novamente.';feedback.classList.toggle('error',!response.ok);if(response.ok)form.reset();}
catch{feedback.textContent='Falha de conexão. Sua mensagem não foi enviada. Tente novamente.';feedback.classList.add('error');}
finally{feedback.hidden=false;feedback.focus();button.disabled=false;const turnstile=(window as unknown as {turnstile?:{reset:()=>void}}).turnstile;turnstile?.reset();const started=form.querySelector<HTMLInputElement>('[name=started_at]');if(started)started.value=String(Date.now());}});
</script>

