---
import Base from '../../layouts/Base.astro'; import Breadcrumb from '../../components/ui/Breadcrumb.astro'; import ProductCard from '../../components/catalog/ProductCard.astro'; import Icon from '../../components/ui/Icon.astro'; import {getProduct,getProducts} from '../../services/catalog'; import {site,whatsappUrl} from '../../config/site';
const product=await getProduct(Astro.params.slug!); if(!product)return Astro.redirect('/404',302);
const related=(await getProducts(new URLSearchParams({categoria:product.categories?.slug || ''}))).products.filter(p=>p.id!==product.id).slice(0,3);
const gallery=[product.imagem_principal,...product.galeria].filter(Boolean);
const schema=product.demo?undefined:{'@type':'Product',name:product.nome,description:product.descricao_curta,image:gallery.map(src=>new URL(src,site.domain||Astro.url.origin).href),sku:product.codigo,...(product.brands?{brand:{'@type':'Brand',name:product.brands.nome}}:{})};
---
<Base title={product.nome} description={product.descricao_curta} schema={schema} noindex={product.demo}><Breadcrumb items={[{label:'Produtos',href:'/produtos'},{label:product.nome}]}/><section class="section product-detail"><div class="container product-detail-grid"><div class="gallery"><div class="main-product-image"><img id="main-product-image" src={gallery[0]||'/images/product-parts.svg'} alt={product.nome} width="800" height="700" fetchpriority="high"/>{product.demo&&<span class="demo-tag">Imagem ilustrativa</span>}</div>{gallery.length>1&&<div class="gallery-thumbnails">{gallery.map((src,i)=><button class="gallery-thumbnail" aria-label={'Ver imagem '+(i+1)} aria-pressed={i===0?'true':'false'} data-src={src}><img src={src} alt="" width="100" height="90" loading="lazy"/></button>)}</div>}</div><div class="product-detail-copy"><p class="eyebrow">{product.categories?.nome}</p><h1>{product.nome}</h1><p class="lead">{product.descricao_curta}</p><dl class="product-meta">{product.brands&&<div><dt>Marca</dt><dd>{product.brands.nome}</dd></div>}<div><dt>Código</dt><dd>{product.codigo}</dd></div></dl><div class="quote-panel"><span>UMA SOLUÇÃO PARA O SEU PROJETO</span><h2>Consulte-nos</h2><p>Fale com nossa equipe para conhecer condições e disponibilidade.</p><a class="button" href={'/contato?assunto=Orçamento&produto='+encodeURIComponent(product.nome)}>Solicitar orçamento <Icon name="ArrowUpRight" size={19}/></a>{site.whatsapp&&<a class="text-link" href={whatsappUrl('Olá! Gostaria de um orçamento para '+product.nome+' (código '+product.codigo+').')}>Conversar pelo WhatsApp <Icon name="MessageCircle" size={19}/></a>}</div>{product.demo&&<p class="small-note">Produto de demonstração. Não representa uma oferta comercial.</p>}</div></div><div class="container product-description"><div><p class="eyebrow">CONHEÇA A SOLUÇÃO</p><h2>Sobre o produto</h2><p>{product.descricao}</p></div><div><h2>Especificações</h2><dl class="specifications">{Object.entries(product.especificacoes).map(([key,value])=><div><dt>{key}</dt><dd>{value}</dd></div>)}</dl></div></div></section>{related.length>0&&<section class="section soft-bg"><div class="container"><div class="section-heading"><h2>Complete o <span>cuidado.</span></h2><a class="text-link" href="/produtos">Ver catálogo <Icon name="ArrowUpRight"/></a></div><div class="product-grid">{related.map(p=><ProductCard product={p}/>)}</div></div></section>}</Base>
<script>
document.querySelectorAll<HTMLButtonElement>('.gallery-thumbnail').forEach(button=>button.addEventListener('click',()=>{const main=document.querySelector<HTMLImageElement>('#main-product-image');if(main&&button.dataset.src)main.src=button.dataset.src;document.querySelectorAll('.gallery-thumbnail').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}));
</script>

