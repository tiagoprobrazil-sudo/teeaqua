---
import Base from '../../layouts/Base.astro';import Breadcrumb from '../../components/ui/Breadcrumb.astro';import {getPosts} from '../../services/catalog';import {site} from '../../config/site';import Icon from '../../components/ui/Icon.astro';
const post=(await getPosts()).find(p=>p.slug===Astro.params.slug);if(!post)return Astro.redirect('/404',302);
const schema={'@type':'Article',headline:post.titulo,description:post.resumo,image:post.imagem,author:{'@type':'Organization',name:site.name},publisher:{'@id':(site.domain||Astro.url.origin)+'/#organization'},...(post.published_at?{datePublished:post.published_at,dateModified:post.updated_at}:{})};
---
<Base title={post.titulo} description={post.resumo} schema={schema}><Breadcrumb items={[{label:'Dicas',href:'/dicas'},{label:post.titulo}]}/><article class="section"><div class="container"><div class="article-title"><p class="eyebrow">{post.post_categories?.nome || 'Dicas'}</p><h1>{post.titulo}</h1><p class="lead">{post.resumo}</p>{post.published_at&&<time datetime={post.published_at}>{new Date(post.published_at).toLocaleDateString('pt-BR')}</time>}</div><img class="article-hero" src={post.imagem} alt="" width="1280" height="650" fetchpriority="high"/><div class="editorial article-body">{post.conteudo.split('\n\n').map(p=><p>{p}</p>)}<div class="contact-strip admin-card"><h2>Conte com a Tee Aqua.</h2><p>Vamos encontrar as soluções para sua piscina?</p><a class="text-link" href="/contato">Fale com a equipe <Icon name="ArrowUpRight" size={19}/></a></div><a class="text-link" href="/dicas"><Icon name="ArrowLeft" size={17}/> Todas as dicas</a></div></div></article></Base>

