import Base from '../layouts/Base.astro';import Heading from '../components/ui/PageHeading.astro';import Company from '../sections/Company.astro';import Impact from '../sections/Impact.astro';import Icon from '../components/ui/Icon.astro';
---
<Base title="A empresa"><Heading eyebrow="CONHEÇA A TEE AQUA" title="Cuidar da água. Valorizar os momentos." description="Materiais e soluções para quem acredita que uma piscina bem cuidada faz parte de uma vida melhor."/><Company/><section class="section soft-bg"><div class="container solutions-grid"><article class="solution"><Icon name="Droplets" size={35}/><h2>Cuidado completo</h2><p>Produtos e equipamentos para o tratamento, a limpeza e a manutenção da piscina, reunidos em um só lugar.</p></article><article class="solution"><Icon name="MessageCircle" size={35}/><h2>Conversa próxima</h2><p>Queremos entender sua necessidade para ajudar na escolha de materiais adequados ao seu projeto.</p></article><article class="solution"><Icon name="Sun" size={35}/><h2>Mais tranquilidade</h2><p>Soluções para residências, profissionais e empresas que buscam praticidade no cuidado com piscinas.</p></article></div></section><Impact/></Base>

