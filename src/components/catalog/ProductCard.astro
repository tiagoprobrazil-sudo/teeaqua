---
import Icon from '../ui/Icon.astro'; import type { Product } from '../../types/catalog';
interface Props {product:Product} const {product}=Astro.props;
---
<article class="product-card"><a href={'/produto/'+product.slug} class="product-image"><img src={product.imagem_principal || '/images/product-parts.svg'} alt={product.demo?'Ilustração de '+product.nome:product.nome} width="540" height="440" loading="lazy" decoding="async"/>{product.demo&&<span class="demo-tag">Ilustrativo</span>}<span class="product-arrow"><Icon name="ArrowUpRight"/></span></a><div class="product-info"><p class="eyebrow">{product.categories?.nome || 'Piscinas'}</p><h3><a href={'/produto/'+product.slug}>{product.nome}</a></h3><p>{product.descricao_curta}</p><a class="text-link" href={'/produto/'+product.slug}>Ver detalhes <Icon name="ArrowRight" size={17}/></a></div></article>

