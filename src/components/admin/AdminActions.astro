<p class="form-feedback" id="admin-feedback" role="status" tabindex="-1" hidden></p>
<script>
const feedback=document.getElementById('admin-feedback')!;
document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach(button=>button.addEventListener('click',async()=>{if(!window.confirm('Excluir '+button.dataset.label+'? Esta ação não pode ser desfeita.'))return;button.disabled=true;try{const response=await fetch(button.dataset.delete!,{method:'DELETE'});const result=await response.json();if(response.ok)window.location.reload();else throw new Error(result.error||'Não foi possível excluir.');}catch(e){feedback.textContent=e instanceof Error?e.message:'Erro de conexão.';feedback.classList.add('error');feedback.hidden=false;feedback.focus();button.disabled=false;}}));
document.querySelectorAll<HTMLFormElement>('[data-admin-form]').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();const button=form.querySelector<HTMLButtonElement>('button[type=submit]')!;button.disabled=true;try{const data=Object.fromEntries(new FormData(form));const response=await fetch(form.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const result=await response.json();if(!response.ok)throw new Error(result.error||'Não foi possível salvar.');window.location.assign(form.dataset.return||window.location.pathname);}catch(e){feedback.textContent=e instanceof Error?e.message:'Falha ao salvar.';feedback.classList.add('error');feedback.hidden=false;feedback.focus();button.disabled=false;}}));
</script>

