---
import {safeJson} from '../../lib/validation'; import {site} from '../../config/site';
interface Props { items:{label:string;href?:string}[]; }
const {items}=Astro.props; const all=[{label:'Início',href:'/'},...items];
---
<nav class="breadcrumb container" aria-label="Você está aqui"><ol>{all.map((item,i)=><li>{i>0&&<span aria-hidden="true">/</span>}{item.href?<a href={item.href}>{item.label}</a>:<span aria-current="page">{item.label}</span>}</li>)}</ol></nav>
<script type="application/ld+json" set:html={safeJson({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:all.map((item,i)=>({'@type':'ListItem',position:i+1,name:item.label,item:new URL(item.href||Astro.url.pathname,site.domain||Astro.url.origin).href}))})}/>

