---
import '@fontsource-variable/manrope';import '@fontsource-variable/dm-sans';import '../styles/global.css';import Logo from '../components/ui/Logo.astro';
const {title}=Astro.props;const links=[['Dashboard','/admin'],['Produtos','/admin/produtos'],['Categorias','/admin/categorias'],['Marcas','/admin/marcas'],['Contatos','/admin/contatos'],['Artigos','/admin/artigos']];
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{title} — Administração T&E Aqua</title><link rel="icon" href="/brand/logo-symbol.png"/></head><body><a class="skip-link" href="#admin-content">Pular para conteúdo</a><div class="admin-shell"><aside class="admin-sidebar"><a href="/admin" aria-label="Dashboard T&E Aqua"><Logo white/></a><nav aria-label="Administração">{links.map(([name,url])=><a href={url} aria-current={Astro.url.pathname===url||(url!=='/admin'&&Astro.url.pathname.startsWith(url+'/'))?'page':undefined}>{name}</a>)}</nav><div class="admin-bottom"><a href="/">Ver o site ↗</a><form action="/api/admin/logout" method="post"><button type="submit">Sair da conta</button></form><span class="admin-credit">Desenvolvido por <a href="https://www.tiagobrazil.com.br" rel="noopener noreferrer" target="_blank">Tiago Brazil</a></span></div></aside><main class="admin-content" id="admin-content"><div class="admin-top"><div><p class="eyebrow">T&E AQUA • ADMINISTRAÇÃO</p><h1>{title}</h1></div><slot name="action"/></div><slot/></main></div></body></html>

