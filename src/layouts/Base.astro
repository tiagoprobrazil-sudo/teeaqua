---
import '@fontsource-variable/manrope'; import '@fontsource-variable/dm-sans';
import '../styles/global.css'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro';
import {site,demoMode} from '../config/site'; import {safeJson} from '../lib/validation';
interface Props { title?:string; description?:string; hero?:boolean; noindex?:boolean; schema?:Record<string,unknown>; }
const {title,description=site.description,hero=false,noindex=false,schema}=Astro.props;
const origin=site.domain || Astro.url.origin; const canonical=new URL(Astro.url.pathname,origin).href;
const fullTitle=title?`${title} | T&E Aqua Solutions`:'T&E Aqua Solutions — Tudo para uma piscina perfeita';
const graph=[{'@type':'Organization','@id':origin+'/#organization',name:site.name,url:origin,logo:new URL('/brand/logo-horizontal.svg',origin).href,...(site.email?{email:site.email}:{}),...(site.phone?{telephone:site.phone}:{})},{'@type':'WebSite','@id':origin+'/#website',name:site.name,url:origin,inLanguage:'pt-BR'},...(schema?[schema]:[])];
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#082F49"/><title>{fullTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/brand/logo-symbol.png" type="image/png"/>{(noindex||demoMode)&&<meta name="robots" content="noindex,follow"/>}<meta property="og:type" content={schema?.['@type']==='Article'?'article':'website'}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content="pt_BR"/><meta property="og:site_name" content={site.name}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><slot name="head"/><script type="application/ld+json" set:html={safeJson({'@context':'https://schema.org','@graph':graph})}/></head><body><a href="#conteudo" class="skip-link">Pular para o conteúdo</a><Header transparent={hero}/><main id="conteudo" class:list={[{'interior-main':!hero}]}><slot/></main><Footer/>
<script>
if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
document.querySelectorAll<HTMLVideoElement>('video[data-lazy]').forEach(video=>{
const observer=new IntersectionObserver(([entry])=>{
if(!entry.isIntersecting)return;
video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach(s=>{s.src=s.dataset.src!;});
video.load();video.play().catch(()=>{});
observer.disconnect();
},{rootMargin:'200px'});
observer.observe(video);
});
}
</script>
</body></html>

