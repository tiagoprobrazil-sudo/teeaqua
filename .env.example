# Copy to .dev.vars for Cloudflare local runtime. Never commit credentials.
SITE_URL=http://localhost:4321
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames allowed by Turnstile (no protocol).
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
# Explicit opt-in only: illustrative catalog, never mixed into the real database.
DEMO_MODE=true
SITE_PHONE=
SITE_WHATSAPP=
SITE_EMAIL=
SITE_ADDRESS=
SITE_INSTAGRAM=
SITE_FACEBOOK=
